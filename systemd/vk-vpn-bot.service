[Unit]
Description=VK VPN Telegram Bot
After=network.target vk-vpn-daemon.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/vk-vpn/vk-vpn-bot
EnvironmentFile=-/opt/vk-vpn/vk-vpn-bot/.env
ExecStart=/opt/vk-vpn/vk-vpn-bot/venv/bin/python bot.py
Restart=on-failure
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
